# Broker worker image (Render Background Worker, Singapore region).
#
# Only the WORKER is containerised. The web service stays on Render's native
# Python runtime (see render.yaml) — nothing here affects it.
#
# Why Docker at all: KGI's SuperPy SDK needs its `libCGCrypt.so` signing
# library installed at the SYSTEM level (chmod 755 + copied into
# /lib/x86_64-linux-gnu/ on Ubuntu, /lib64/ on CentOS/RedHat), and Fubon's
# fubon_neo isn't on PyPI. That level of filesystem control needs explicit
# steps in an image; it is not reliable in a buildpack runtime's build/run
# split.
#
# Issue #43: this image runs the real broker client code — broker_worker.py
# polls broker_desired_state and actually logs in to KGI/Fubon with the
# credential the user entered in the Live warrant form (#42). It is no longer
# the Phase-0 heartbeat stub. Live ticks are still out of scope (#44/#45).
#
# Issue #48: KGI's libCGCrypt.so and Fubon's fubon_neo wheel are proprietary
# binaries this public repo can't commit (docs/vendor/README.md), so they
# aren't baked into the image at build time. worker-entrypoint.sh fetches them
# from a private Supabase Storage bucket at container START instead — root
# installs them, then drops to the unprivileged `worker` user before running
# broker_worker.py. See scripts/install_worker_binaries.py and
# supabase/migrations/015_broker_binaries_bucket.sql.

FROM python:3.11-slim-bookworm

# Faster, quieter, no .pyc clutter; unbuffered so Render's log stream is live.
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    # Days-to-expiry and every market-hours decision are computed against local
    # "today"; west of Taiwan the local date lags and expired batches leak in.
    TZ=Asia/Taipei \
    # glibc per-thread malloc arenas balloon RSS under threaded workloads.
    MALLOC_ARENA_MAX=2

WORKDIR /app

# Build toolchain for any wheels without a manylinux build, tzdata so TZ above
# actually resolves, and gosu so worker-entrypoint.sh can drop from root (which
# it needs to install libCGCrypt.so system-wide) to the unprivileged `worker`
# user before running broker_worker.py.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential \
        ca-certificates \
        tzdata \
        gosu \
    && rm -rf /var/lib/apt/lists/*

# Same requirements.txt as the web service. kgisuperpy lives there (it is
# harmless to install anywhere); fubon_neo is NOT — it is not on PyPI, and is
# instead installed at container start by worker-entrypoint.sh (issue #48; see
# that file and scripts/install_worker_binaries.py). Both are imported only by
# the worker.
COPY requirements.txt ./
RUN pip install --upgrade pip && pip install -r requirements.txt

# ---------------------------------------------------------------------------
# TODO(vendoring, issue #47): pythonnet/QuoteCom benchmark client — optional,
# not needed for the production kgisuperpy path above.
#
# services/broker/kgi_pythonnet_client.py needs, on top of `pip install
# pythonnet` (see requirements.txt):
#
#   RUN apt-get update && apt-get install -y --no-install-recommends mono-complete \
#       && rm -rf /var/lib/apt/lists/*
#   COPY vendor/kgi_quotecom/*.dll vendor/kgi_quotecom/
#
# (Package.dll, PushClient.dll, QuoteCom.dll, Interop.KGICGCAPIATLLib.dll,
# ICSharpCode.SharpZipLib.dll — obtained from KGI, not on PyPI, not committed
# per docs/vendor/README.md's compiled-binary exclusion.)
#
# Left commented out: none of the DLLs are vendored yet, `mono-complete` adds
# ~250MB to every worker image build for a benchmark-only path, and nothing in
# broker_worker.py's production flow imports kgi_pythonnet_client.py. Add this
# block only when actually running scripts/kgi_client_benchmark.py.
# ---------------------------------------------------------------------------

COPY . .
RUN chmod +x worker-entrypoint.sh

# The image stays root by default (no USER here): worker-entrypoint.sh needs
# root to install libCGCrypt.so system-wide at container start, then drops to
# this unprivileged user via gosu before broker_worker.py runs (#48).
RUN useradd --create-home --uid 10001 worker \
    && chown -R worker:worker /app

ENTRYPOINT ["./worker-entrypoint.sh"]
CMD ["python", "-u", "broker_worker.py"]
