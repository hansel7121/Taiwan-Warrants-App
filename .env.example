# Supabase configuration. Copy to .env and fill in (the app reads .env at import).
# Leave these blank to run locally with NO auth (single-user, in-memory).
# SUPABASE_URL must be the bare project URL — no /rest/v1/ or other path
# (the app appends /auth/v1/... and supabase-py adds its own paths).
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Optional: only needed for the HS256 (legacy JWT secret) fallback.
SUPABASE_JWT_SECRET=

# Optional. Set MARKET_SOURCE=supabase to run in shared-snapshot mode matching
# Render: reads serve the Supabase market-data snapshot and POST /refresh writes
# it (overwriting the same batch the live site shares). Leave unset for pure-local
# sandboxed dev, where every fetch live-scrapes CMoney/TAIFEX/MIS directly.
# MARKET_SOURCE=supabase

# --- Local redundancy instance (no-login mode) --------------------------------
# Set LOCAL_USER_ID on a localhost instance to run with NO login: the app acts
# as this fixed user against the SAME shared Supabase (source of truth) and keeps
# a readable portfolio.json mirror. It must be the Supabase auth.users UUID this
# instance acts as. Presence of LOCAL_USER_ID *and* absence of RENDER enables
# no-login local mode; on Render leave this blank (RENDER is set there, so the
# bypass stays off and production auth is untouched).
# LOCAL_USER_ID=
# Optional display email for that local user (defaults to local@localhost).
# LOCAL_USER_EMAIL=

# --- Fubon live market data ---------------------------------------------------
# Read by scripts/fubon_quote_viewer.py, not by the app itself. The cert is a
# local .p12 path (keep it under local_certs/, which is gitignored). Never
# commit real values.
# FUBON_ID=
# FUBON_PASSWORD=
# FUBON_CERT_PATH=local_certs/your_cert.p12
# FUBON_CERT_PASSWORD=
