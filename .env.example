# Supabase config. Copy to .env and fill in. Leave blank for local, no-auth, in-memory mode.
# SUPABASE_URL must be the bare project URL (no /rest/v1/ or other path).
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Only needed for the HS256 (legacy JWT secret) fallback.
SUPABASE_JWT_SECRET=

# Set to run in shared-snapshot mode like Render (reads/writes the Supabase
# market-data snapshot). Leave unset to live-scrape CMoney/TAIFEX/MIS locally.
# MARKET_SOURCE=supabase

# --- Local redundancy instance (no-login mode) --------------------------------
# Set LOCAL_USER_ID (a Supabase auth.users UUID) to run with no login: acts as
# that fixed user against the shared Supabase, with a portfolio.json mirror.
# Requires RENDER to be unset. Leave blank on Render.
# LOCAL_USER_ID=
# Optional display email for that local user (defaults to local@localhost).
# LOCAL_USER_EMAIL=

# --- Fubon live market data ---------------------------------------------------
# Used only by scripts/fubon_quote_viewer.py, which logs in with credentials
# read from Supabase (fubon_credentials table, see services/broker/) rather
# than from env vars. Requires SUPABASE_URL/SUPABASE_SERVICE_ROLE_KEY above,
# plus:

# Fernet key (generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
# Required to decrypt rows in fubon_credentials. Never commit the real value.
# BROKER_CRED_KEY=
# Which fubon_credentials row to log in with. Defaults to "default".
# FUBON_CRED_LABEL=default

# One-off: scripts/seed_fubon_credentials.py reads these to seed/update a
# fubon_credentials row, then they are no longer used at runtime.
# FUBON_ID=
# FUBON_PASSWORD=
# FUBON_CERT_PATH=local_certs/your_cert.p12
# FUBON_CERT_PASSWORD=
