# Keep the worker image small and, more importantly, keep local secrets and
# local state out of it — Dockerfile.worker does a `COPY . .`, so anything not
# excluded here gets baked into the published image. All worker config comes
# from Render env vars (render.yaml), never from a committed/copied .env.
.env
.env.*
*.pem
*.key

.git
.gitignore
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/

# Web-app-only assets and local artefacts the worker never reads.
notebooks/
tests/
static/
templates/
docs/
portfolio.json
*.pdf
.DS_Store
